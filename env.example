NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase Client (Firebase Console → Project settings → Web app config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin JSON (paste the full service-account JSON object as ONE line).
# Needed for verifying ID tokens (/api/checkout) and webhook Firestore writes.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account"}

# Guest login shortcut (assignment example). Must exist in Firebase Auth.
NEXT_PUBLIC_GUEST_EMAIL=guest@gmail.com
NEXT_PUBLIC_GUEST_PASSWORD=guest123

# Stripe (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe prices (Subscriptions). Yearly Checkout session adds a 7-day trial via API.
STRIPE_PRICE_MONTHLY=price_xxxxx
STRIPE_PRICE_YEARLY=price_yyyyy
